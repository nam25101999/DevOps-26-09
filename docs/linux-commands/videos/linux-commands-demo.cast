[23.0, "o", "\r\n\u001b[36m┌─────────────────────────────────────────────┐\r\n│  📄 PHẦN 3: QUẢN LÝ FILE                   │\r\n└─────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[24.0, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[24.3, "o", "touch file.txt readme.txt config.yml\r\n"]
[24.8, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[25.0, "o", "echo \"Hello DevOps!\" > file.txt\r\n"]
[25.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[25.8, "o", "cat file.txt\r\n"]
[26.0, "o", "Hello DevOps!\r\nDòng 2: Học Linux\r\nDòng 3: Thực hành command\r\n"]
[27.0, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[27.3, "o", "cp file.txt backup.txt\r\n"]
[27.8, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[28.0, "o", "cp -r project project-backup\r\n"]
[28.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[28.8, "o", "mv readme.txt readme-renamed.txt\r\n"]
[29.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[29.8, "o", "rm backup.txt\r\n"]
[30.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[30.8, "o", "ls -la *.txt\r\n"]
[31.0, "o", "-rw-r--r-- 1 nam nam 109 Aug 29 03:11 file.txt\r\n-rw-r--r-- 1 nam nam   0 Aug 29 03:11 readme-renamed.txt\r\n"]
[32.5, "o", "\r\n\u001b[36m┌─────────────────────────────────────────────┐\r\n│  👀 PHẦN 4: ĐỌC FILE                       │\r\n└─────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[33.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[33.8, "o", "head -n 5 bigfile.txt\r\n"]
[34.0, "o", "Line 1: DevOps learning - Lệnh Linux số 1\r\nLine 2: DevOps learning - Lệnh Linux số 2\r\nLine 3: DevOps learning - Lệnh Linux số 3\r\nLine 4: DevOps learning - Lệnh Linux số 4\r\nLine 5: DevOps learning - Lệnh Linux số 5\r\n"]
[35.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[35.8, "o", "tail -n 5 bigfile.txt\r\n"]
[36.0, "o", "Line 21: DevOps learning - Lệnh Linux số 21\r\nLine 22: DevOps learning - Lệnh Linux số 22\r\nLine 23: DevOps learning - Lệnh Linux số 23\r\nLine 24: DevOps learning - Lệnh Linux số 24\r\nLine 25: DevOps learning - Lệnh Linux số 25\r\n"]
[37.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[37.8, "o", "wc -l bigfile.txt\r\n"]
[38.0, "o", "25 bigfile.txt\r\n"]
[39.5, "o", "\r\n\u001b[36m┌─────────────────────────────────────────────┐\r\n│  🔍 PHẦN 5: TÌM KIẾM FILE (find)           │\r\n└─────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[40.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[40.8, "o", "find . -type f\r\n"]
[41.0, "o", "./bigfile.txt\r\n./file.txt\r\n./config.yml\r\n./project/backend/application.yml\r\n./project/backend/app.log\r\n./project/frontend/index.html\r\n"]
[42.5, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[42.8, "o", "find . -name \"*.yml\"\r\n"]
[43.0, "o", "./config.yml\r\n./project/backend/application.yml\r\n"]
[44.0, "o", "\u001b[32mnam@KhanhLinh\u001b[0m:\u001b[34m~\u001b[0m$ "]
[44.3, "o", "find . -name \"*.log\"\r\n"]
[44.5, "o", "./project/backend/app.log\r\n"]
[46.0, "o", "\r\n\u001b[33m┌─────────────────────────────────────────────┐\r\n│  🔎 PHẦN 6: GREP - Tìm kiếm nội dung       │\r\n└─────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
