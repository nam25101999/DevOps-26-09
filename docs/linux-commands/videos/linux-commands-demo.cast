[16.5, "o", "\r\n\u001b[36m┌─────────────────────────────────────────────┐\r\n│  📁 PHẦN 2: QUẢN LÝ THƯ MỤC               │\r\n└─────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
